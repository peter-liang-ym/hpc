<div class="row">
    <div class="col s8 offset-s2">
        <div class="profile center-align">
            <div class="profile-name">{{character.Name}}</div>
            <div class="profile-content">Birth: {{character.Birth}}</div>
            <div class="profile-content">Death: {{character.Death}}</div>
            <div class="profile-content">Gender: {{character.Gender}}</div>
            <div class="profile-content">Job: {{character.Job}}</div>
            <div class="profile-content">House: {{character.House}}</div>
            <div class="profile-content">Wand: {{character.Wand}}</div>
            <div class="profile-content">Patronus: {{character.Patronus}}</div>
            <div class="profile-content">Species: {{character.Species}}</div>
            <div class="profile-content">Blood status: {{character.bloodStatus}}</div>
            <div class="profile-content">Hair color: {{character.hairColor}}</div>
            <div class="profile-content">Eye color: {{character.eyeColor}}</div>
            <div class="profile-content">Loyalty: {{character.Loyalty}}</div>
        </div>
    </div>
</div>