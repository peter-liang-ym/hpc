{{#if notFound}}
    <div class="notice center-align">
        No results found.
    </div>
{{else}}
    <div class="notice center-align">
        Results:
    </div>
    <div class="table-container">
        
        <table class="centered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                </tr>
            </thead>

            <tbody>
            {{#each characterFound}}
            <tr>
                <td>
                    <a class="entry" href="/character?id={{this.Id}}">{{this.Name}}</a>
                </td>
                <td>Character</td>
            </tr>
            {{/each}}
            {{#each potionFound}}
            <tr>
                <td>
                    <a class="entry" href="/potion?id={{this.Id}}">{{this.Name}}</a>
                </td>
                <td>Potion</td>
            </tr>
            {{/each}}
            {{#each spellFound}}
            <tr>
                <td>
                    <a class="entry" href="/spell?id={{this.Id}}">{{this.Name}}</a>
                </td>
                <td>Spell</td>
            </tr>
            {{/each}}
            </tbody>
        </table>
        {{/if}}
    </div>